name = "clipboard-rooms-api"
main = "src/index.mjs"
compatibility_date = "2026-11-01"

# Change this for your own Pages host.
[vars]
ALLOWED_ORIGIN = "https://namthedev.github.io"

[[d1_databases]]
binding = "DB"
database_name = "clipboard-rooms"
database_id = "PASTE_YOUR_DATABASE_UUID_HERE"

[triggers]
crons = ["0 3 * * *"]
